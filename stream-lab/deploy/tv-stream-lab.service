[Unit]
Description=Tesla Media
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tvstream
Group=tvstream
WorkingDirectory=/opt/tv-stream-lab-v4
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8787
Environment=DATA_DIR=/var/lib/tv-stream-lab
# Optional: a missing helper automatically hides the YouTube integration.
Environment=YT_DLP_PATH=/opt/tesla-ytdlp/current/yt-dlp
StateDirectory=tv-stream-lab
StateDirectoryMode=0700
ExecStart=/opt/tv-node/bin/node /opt/tv-stream-lab-v4/server.mjs
Restart=always
RestartSec=3
TimeoutStopSec=10
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
UMask=0077
Nice=5

[Install]
WantedBy=multi-user.target
